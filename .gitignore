# ==============================================================================
# Git Ignore Configuration - AI Agent Workflow Automation System
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets (Keep .env.example safe for cloning)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Testing & Code Quality Cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# User Uploads & Temporary Run Files
backend/uploads/*
!backend/uploads/.gitkeep
scratch/
scratch_*.py
temp/
tmp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node & Frontend Dependencies / Builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm/
.eslintcache

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
